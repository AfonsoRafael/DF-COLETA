{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend",
  "installCommand": "npm install",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:caminho*",
      "destination": "/api/index?caminho=:caminho*"
    }
  ]
}
